# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# Workflow-related files can carry real (sometimes NSFW) prompt text via
# positive_prompt - never committed, kept local-only. workflows/ itself is no
# longer used to store snapshots (workflows are always fetched fresh from
# ComfyUI - see live_workflow.py) but stays ignored in case anything's ever
# cached there for debugging.
workflows/
configs/model-testing-config.json

# Per-run output logs - local only.
runs/

# GUI: local machine settings (server URL, local folder paths) and the
# config the GUI writes out right before each run (can carry real prompt
# text via positive_prompt, same reasoning as above).
gui_settings.json
gui_last_run.json

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
